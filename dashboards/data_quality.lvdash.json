{
  "datasets": [
    {
      "displayName": "last_run_totals",
      "name": "a1f00001",
      "queryLines": [
        "WITH last AS (SELECT max_by(run_id, run_time) AS run_id FROM dq_summary_metrics)\n",
        "SELECT\n",
        "  sum(CASE WHEN metric_name = 'error_row_count' THEN CAST(metric_value AS BIGINT) END) AS rejected_rows,\n",
        "  sum(CASE WHEN metric_name = 'warning_row_count' THEN CAST(metric_value AS BIGINT) END) AS warning_rows,\n",
        "  sum(CASE WHEN metric_name = 'input_row_count' THEN CAST(metric_value AS BIGINT) END) AS input_rows,\n",
        "  max(run_time) AS run_time\n",
        "FROM dq_summary_metrics m\n",
        "JOIN last l ON m.run_id = l.run_id;"
      ]
    },
    {
      "displayName": "revised_last_load",
      "name": "a1f00002",
      "queryLines": [
        "SELECT\n",
        "  coalesce(sum(revised_rows), 0) AS revised_rows,\n",
        "  coalesce(sum(compared_rows), 0) AS compared_rows,\n",
        "  max(loaded_at) AS loaded_at\n",
        "FROM dq_revisions\n",
        "WHERE loaded_at >= (SELECT max(loaded_at) - INTERVAL 1 HOUR FROM dq_revisions);"
      ]
    },
    {
      "displayName": "ref_integrity_problems",
      "name": "a1f00003",
      "queryLines": [
        "SELECT count(*) AS problems\n",
        "FROM ref_integrity;"
      ]
    },
    {
      "displayName": "freshness",
      "name": "a1f00004",
      "queryLines": [
        "SELECT\n",
        "  table_name,\n",
        "  last_loaded_at,\n",
        "  timestampdiff(HOUR, last_loaded_at, current_timestamp()) AS age_hours,\n",
        "  row_count,\n",
        "  CASE\n",
        "    WHEN timestampdiff(HOUR, last_loaded_at, current_timestamp()) <= 192 THEN '🟢'\n",
        "    WHEN timestampdiff(HOUR, last_loaded_at, current_timestamp()) <= 360 THEN '🟡'\n",
        "    ELSE '🔴'\n",
        "  END AS status,\n",
        "  CASE\n",
        "    WHEN timestampdiff(HOUR, last_loaded_at, current_timestamp()) <= 192 THEN 'Fresh (up to 8 days)'\n",
        "    WHEN timestampdiff(HOUR, last_loaded_at, current_timestamp()) <= 360 THEN 'Late (8 to 15 days)'\n",
        "    ELSE 'Stale (over 15 days)'\n",
        "  END AS freshness\n",
        "FROM dq_freshness\n",
        "ORDER BY last_loaded_at;"
      ]
    },
    {
      "displayName": "last_run_by_table",
      "name": "a1f00005",
      "queryLines": [
        "WITH last AS (SELECT max_by(run_id, run_time) AS run_id FROM dq_summary_metrics),\n",
        "per_table AS (\n",
        "  SELECT\n",
        "    input_location AS table_name,\n",
        "    max(CASE WHEN metric_name = 'error_row_count' THEN CAST(metric_value AS BIGINT) END) AS rejected,\n",
        "    max(CASE WHEN metric_name = 'warning_row_count' THEN CAST(metric_value AS BIGINT) END) AS warned\n",
        "  FROM dq_summary_metrics m\n",
        "  JOIN last l ON m.run_id = l.run_id\n",
        "  WHERE metric_name <> 'check_metrics'\n",
        "  GROUP BY input_location\n",
        ")\n",
        "SELECT table_name, stack(2, 'Rejected', rejected, 'Warning', warned) AS (kind, row_count)\n",
        "FROM per_table\n",
        "ORDER BY table_name;"
      ]
    },
    {
      "displayName": "rejected_per_run",
      "name": "a1f00006",
      "queryLines": [
        "WITH runs AS (\n",
        "  SELECT\n",
        "    run_id,\n",
        "    min(run_time) AS run_time,\n",
        "    sum(CASE WHEN metric_name = 'error_row_count' THEN CAST(metric_value AS BIGINT) END) AS rejected,\n",
        "    sum(CASE WHEN metric_name = 'warning_row_count' THEN CAST(metric_value AS BIGINT) END) AS warned\n",
        "  FROM dq_summary_metrics\n",
        "  GROUP BY run_id\n",
        ")\n",
        "SELECT run_time, stack(2, 'Rejected (error)', rejected, 'Warning', warned) AS (kind, row_count)\n",
        "FROM runs\n",
        "ORDER BY run_time;"
      ]
    },
    {
      "displayName": "revisions_by_load",
      "name": "a1f00007",
      "queryLines": [
        "SELECT\n",
        "  CASE WHEN revised_rows > 0 THEN '🟡' ELSE '🟢' END AS status,\n",
        "  table_name, loaded_at, date_format(loaded_at, 'yyyy-MM-dd HH:mm') AS load_label, compared_rows, revised_rows\n",
        "FROM dq_revisions\n",
        "ORDER BY loaded_at, table_name;"
      ]
    },
    {
      "displayName": "top_failing_checks",
      "name": "a1f00008",
      "queryLines": [
        "WITH last AS (SELECT max_by(run_id, run_time) AS run_id FROM dq_summary_metrics),\n",
        "checks AS (\n",
        "  SELECT\n",
        "    m.input_location AS table_name,\n",
        "    from_json(\n",
        "      m.metric_value,\n",
        "      'array<struct<check_name:string,error_count:bigint,warning_count:bigint,checked_count:bigint>>'\n",
        "    ) AS c\n",
        "  FROM dq_summary_metrics m\n",
        "  JOIN last l ON m.run_id = l.run_id\n",
        "  WHERE m.metric_name = 'check_metrics'\n",
        ")\n",
        "SELECT\n",
        "  CASE WHEN x.error_count > 0 THEN '🔴' ELSE '🟡' END AS status,\n",
        "  table_name,\n",
        "  x.check_name AS check_name,\n",
        "  x.error_count AS rejected_rows,\n",
        "  x.warning_count AS warning_rows,\n",
        "  x.checked_count AS checked_rows\n",
        "FROM checks\n",
        "LATERAL VIEW explode(c) t AS x\n",
        "WHERE x.error_count + x.warning_count > 0\n",
        "ORDER BY rejected_rows DESC, warning_rows DESC, check_name;"
      ]
    },
    {
      "displayName": "error_types_last_run",
      "name": "a1f0000a",
      "queryLines": [
        "WITH last AS (SELECT max_by(run_id, run_time) AS run_id FROM dq_summary_metrics),\n",
        "checks AS (\n",
        "  SELECT\n",
        "    from_json(\n",
        "      m.metric_value,\n",
        "      'array<struct<check_name:string,error_count:bigint,warning_count:bigint>>'\n",
        "    ) AS c\n",
        "  FROM dq_summary_metrics m\n",
        "  JOIN last l ON m.run_id = l.run_id\n",
        "  WHERE m.metric_name = 'check_metrics'\n",
        "),\n",
        "flat AS (\n",
        "  SELECT x.check_name AS check_name, x.error_count AS rejected, x.warning_count AS warned\n",
        "  FROM checks\n",
        "  LATERAL VIEW explode(c) t AS x\n",
        ")\n",
        "SELECT kind AS error_type, sum(row_count) AS row_count\n",
        "FROM (\n",
        "  SELECT stack(2, 'Rejected', rejected, 'Warning', warned) AS (kind, row_count)\n",
        "  FROM flat\n",
        ")\n",
        "WHERE row_count > 0\n",
        "GROUP BY kind\n",
        "ORDER BY row_count DESC;"
      ]
    },
    {
      "displayName": "current_quarantine",
      "name": "a1f00009",
      "queryLines": [
        "SELECT table_name, stack(2, 'Rejected', rejected_rows, 'Warning', warning_rows) AS (kind, row_count)\n",
        "FROM (\n",
        "SELECT 'ref_area' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM ref_area_quarantine\n",
        "UNION ALL\n",
        "SELECT 'ref_eia_product' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM ref_eia_product_quarantine\n",
        "UNION ALL\n",
        "SELECT 'ref_fuel_grade' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM ref_fuel_grade_quarantine\n",
        "UNION ALL\n",
        "SELECT 'ref_hub' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM ref_hub_quarantine\n",
        "UNION ALL\n",
        "SELECT 'ref_mid' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM ref_mid_quarantine\n",
        "UNION ALL\n",
        "SELECT 'ref_product' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM ref_product_quarantine\n",
        "UNION ALL\n",
        "SELECT 'ref_terminal_zone' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM ref_terminal_zone_quarantine\n",
        "UNION ALL\n",
        "SELECT 'eia_supply' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM eia_supply_quarantine\n",
        "UNION ALL\n",
        "SELECT 'eia_price' AS table_name, count_if(_errors IS NOT NULL) AS rejected_rows, count_if(_warnings IS NOT NULL) AS warning_rows FROM eia_price_quarantine\n",
        ")\n",
        "ORDER BY table_name;"
      ]
    }
  ],
